# Canonical public site origin. Not a secret.
#
# The production domain is TBD. Do not invent a Mini Mystiq hostname.
# Set this to the public https origin (no path, no trailing slash required)
# before deploying:
#
#   NEXT_PUBLIC_SITE_URL=https://your-real-domain.example
#
# Local development may omit it; the app then falls back to
# http://localhost:3000. That fallback must not be used as the live
# production canonical origin.
NEXT_PUBLIC_SITE_URL=
