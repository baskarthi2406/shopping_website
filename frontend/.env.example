# NEXT_PUBLIC_* values are inlined into browser bundles: never use that prefix
# for credentials. Server-only settings are read via readServerEnv() in
# config/server-env.ts. Put real values in .env.local only; never commit them.

# Zoho (server-only; read by infrastructure/zoho/zoho-config.ts). Leave empty
# here. Base URL must be https with no credentials or query string. Timeout is
# optional (milliseconds, default 10000, max 60000).
ZOHO_API_BASE_URL=
ZOHO_ACCESS_TOKEN=
ZOHO_REQUEST_TIMEOUT_MS=

# Canonical public site origin. Not a secret.
#
# The production domain is TBD. Do not invent a Mini Mystiq hostname.
# Set this to the public https origin (no path, no trailing slash required)
# before deploying:
#
#   NEXT_PUBLIC_SITE_URL=https://your-real-domain.example
#
# Local development may omit it; the app then falls back to
# http://localhost:3000. That fallback must not be used as the live
# production canonical origin.
NEXT_PUBLIC_SITE_URL=
